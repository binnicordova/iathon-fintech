# Copy to .env.local (git-ignored). Everything here is optional.

# Sentry: errors, traces and the LangGraph gen_ai.* spans. Empty = Sentry is a no-op.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
# Also record prompts and replies in Sentry. Leave off: the chat carries ID numbers and bank accounts.
EXPO_PUBLIC_SENTRY_RECORD_AI_CONTENT=false

# WhatsApp number (digits, with country code) for the "Talk on WhatsApp" button.
EXPO_PUBLIC_WHATSAPP_NUMBER=

# Run against the local Firebase emulators (bun run emulators):
#   localhost for web and the iOS simulator, 10.0.2.2 is mapped automatically on Android.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# Only needed to build with EAS (OTA updates / store builds)
EAS_OWNER=
EAS_PROJECT_ID=
