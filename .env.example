# Copy to .env.local (git-ignored). The app runs with NO variables set: it
# points at the Firebase project aibrasper by default (src/constants/firebase.ts).

# --- Optional -------------------------------------------------------------
# Sentry DSN (Sentry project > Settings > Client Keys): errors, traces and the
# LangGraph gen_ai.* spans. Empty = Sentry does nothing.
EXPO_PUBLIC_SENTRY_DSN=

# WhatsApp number (digits, with country code) for the "Talk on WhatsApp"
# button. Empty = it opens WhatsApp's chat picker.
EXPO_PUBLIC_WHATSAPP_NUMBER=

# --- Only to build or publish updates with EAS ----------------------------
EAS_OWNER=
EAS_PROJECT_ID=

# --- Development only -----------------------------------------------------
# Run against the local Firebase emulators (bun run emulators): localhost for
# web and the iOS simulator, your LAN IP on a phone. Android maps it itself.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# --- Rarely needed (defaults are in the code) -----------------------------
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1        # 0-1, default 1
# EXPO_PUBLIC_SENTRY_RECORD_AI_CONTENT=false     # true also sends chat text to Sentry (ID numbers, bank accounts)
# EXPO_PUBLIC_FIREBASE_API_KEY / _AUTH_DOMAIN / _PROJECT_ID / _STORAGE_BUCKET /
# _MESSAGING_SENDER_ID / _APP_ID: only to point at another Firebase project
