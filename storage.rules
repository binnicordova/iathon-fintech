rules_version = '2';

// Payment proofs are private: the client uploads to their own folder; only that
// client and staff (role claim) can read them.
service firebase.storage {
  match /b/{bucket}/o {

    function staff() {
      return request.auth != null
        && request.auth.token.role in ['admin', 'validator', 'operator', 'billing'];
    }

    match /proofs/{uid}/{orderId}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || staff());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
