{
    "name": "brasper",
    "version": "0.1.0",
    "keywords": [
        "expo",
        "expo-go",
        "react-native",
        "fintech",
        "firebase",
        "langgraph",
        "gemma",
        "sentry"
    ],
    "license": "MIT",
    "main": "./src/AppEntry.tsx",
    "files": [
        ".github",
        ".husky/commit-msg",
        ".husky/pre-commit",
        ".rnstorybook",
        ".storybook",
        "assets",
        "functions",
        "resources/privacy-policy.html",
        "scripts",
        "src",
        ".env.example",
        ".nvmrc",
        "app.config.ts",
        "babel.config.js",
        "biome.json",
        "bun.lock",
        "commitlint.config.js",
        "eas.json",
        "gitignore",
        "jest.config.ts",
        "license",
        "metro.config.js",
        "tsconfig.json"
    ],
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "start": "expo start --clear",
        "dev": "APP_VARIANT=development npx expo start",
        "prev": "APP_VARIANT=preview npx expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "build:web": "expo export --platform web --output-dir dist",
        "test": "jest --coverage=false",
        "test:coverage": "jest --coverage",
        "testDebug": "jest --watch --coverage=false",
        "updateSnapshots": "jest -u --coverage=false",
        "format": "biome format --write --files-ignore-unknown=true && biome ci .",
        "format:check": "biome ci --diagnostic-level=error",
        "check:unused": "biome ci --diagnostic-level=error && npm run typecheck",
        "types": "tsc --noEmit --skipLibCheck",
        "prepare": "husky",
        "precheck": "lint-staged",
        "prepack": "node -e \"for (const d of ['.','functions']) require('node:fs').copyFileSync(d+'/.gitignore',d+'/gitignore')\"",
        "postpack": "node -e \"for (const d of ['.','functions']) require('node:fs').rmSync(d+'/gitignore',{force:true})\"",
        "generate:branding": "node scripts/make-branding.mjs",
        "typecheck": "tsc --noEmit --skipLibCheck",
        "functions:install": "npm --prefix functions install",
        "functions:build": "npm --prefix functions run build",
        "emulators": "firebase emulators:start --only functions,firestore,auth,storage",
        "e2e:emulator": "node functions/scripts/e2e-emulator.mjs",
        "seed:demo": "node functions/scripts/seed-demo-data.mjs",
        "reset:test-data": "node functions/scripts/reset-test-data.mjs",
        "mock:gemma": "node functions/scripts/mock-gemma.mjs",
        "deploy:backend": "firebase deploy --only firestore,storage,functions",
        "deploy:web": "bun run build:web && firebase deploy --only hosting"
    },
    "dependencies": {
        "@expo/material-symbols": "^0.1.1",
        "@expo/ui": "57.0.13",
        "@langchain/core": "^1.2.17",
        "@langchain/langgraph": "^1.4.21",
        "@react-native-vector-icons/ionicons": "^13.1.2",
        "@sentry/react-native": "8.30.0",
        "expo": "57.0.18",
        "expo-clipboard": "57.0.1",
        "expo-constants": "57.0.14",
        "expo-crypto": "57.0.2",
        "expo-file-system": "57.0.6",
        "expo-font": "57.0.1",
        "expo-haptics": "57.0.2",
        "expo-image": "57.0.3",
        "expo-image-picker": "57.0.14",
        "expo-linking": "57.0.7",
        "expo-localization": "57.0.1",
        "expo-router": "57.0.16",
        "expo-sharing": "57.0.16",
        "expo-splash-screen": "57.0.8",
        "expo-status-bar": "57.0.1",
        "expo-updates": "57.0.17",
        "firebase": "^13.0.0",
        "jotai": "^2.12.5",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.2",
        "react-native-gesture-handler": "2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "5.7.0",
        "react-native-screens": "4.26.0",
        "react-native-svg": "15.15.4",
        "react-native-web": "0.21.2",
        "react-native-worklets": "0.10.1",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/preset-env": "^7.25.4",
        "@biomejs/biome": "^2.1.3",
        "@commitlint/cli": "^19.8.0",
        "@commitlint/config-conventional": "^19.8.0",
        "@expo/metro-runtime": "57.0.13",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@testing-library/react-native": "^13.2.0",
        "@types/jest": "^29.5.14",
        "@types/react": "~19.2.4",
        "babel-plugin-module-resolver": "^5.0.2",
        "babel-plugin-react-native-web": "^0.19.10",
        "husky": "^9.1.7",
        "jest": "~29.7.0",
        "jest-expo": "57.0.4",
        "lint-staged": "^15.5.0",
        "react-test-renderer": "19.2.3",
        "sharp": "^0.34.5",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3"
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "listUnknownPackages": false
            }
        },
        "install": {
            "exclude": [
                "@expo/metro-runtime",
                "@expo/ui",
                "@sentry/react-native",
                "expo",
                "expo-clipboard",
                "expo-constants",
                "expo-crypto",
                "expo-file-system",
                "expo-font",
                "expo-haptics",
                "expo-image",
                "expo-image-picker",
                "expo-linking",
                "expo-localization",
                "expo-router",
                "expo-sharing",
                "expo-splash-screen",
                "expo-updates",
                "jest-expo",
                "react-native"
            ]
        }
    },
    "private": true,
    "description": "BRASPER: Brazil ⇄ Peru money transfer MVP. Expo Go app (web, iOS, Android) with a quote form, an AI assistant (LangGraph + Gemma, instrumented with Sentry) and a Firebase back office.",
    "lint-staged": {
        "src/**/*.{js,ts,tsx,json}": [
            "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
        ]
    },
    "overrides": {
        "expo-constants": "57.0.14",
        "expo-font": "57.0.1"
    },
    "resolutions": {
        "expo-constants": "57.0.14",
        "expo-font": "57.0.1"
    }
}
