{
  "name": "brasper-functions",
  "private": true,
  "description": "Cloud Functions for BRASPER: rates, quotes, orders, validation, Fact (test mode) and the Gemma proxy.",
  "scripts": {
    "prepare-shared": "node scripts/copy-shared.mjs",
    "build": "npm run prepare-shared && tsc",
    "build:watch": "npm run prepare-shared && tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
