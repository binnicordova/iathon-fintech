rules_version = '2';

// Clients read their own records; only Cloud Functions write orders, quotes,
// invoices and handoffs, so the rate, fees and status can never be set from the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    match /config/{doc} {
      // `config/public` (pricing) and `config/rates` (market reference).
      allow read: if signedIn() && doc in ['public', 'rates'];
      allow write: if false;
    }

    match /quotes/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /orders/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /invoices/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /handoffs/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Saved name, document and accounts, so returning clients do not retype.
    match /clients/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['clientName', 'email', 'docType', 'docNumber', 'language', 'accounts', 'updatedAt']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
