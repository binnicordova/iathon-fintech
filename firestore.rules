rules_version = '2';

// Clients read their own records; only Cloud Functions write orders, quotes,
// invoices and handoffs, so the rate, fees and status can never be set from
// the app. Staff are Firebase Auth users with a `role` custom claim.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ['admin', 'validator', 'operator', 'billing'];
    }

    function isOwner() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    match /config/{doc} {
      // `config/public` (pricing) and `config/rates` (market reference).
      allow read: if signedIn() && doc in ['public', 'rates'];
      allow write: if false;
    }

    match /quotes/{id} {
      allow read: if isOwner() || isStaff();
      allow write: if false;
    }

    match /orders/{id} {
      allow read: if isOwner() || isStaff();
      allow write: if false;
    }

    match /invoices/{id} {
      allow read: if isOwner() || isStaff();
      allow write: if false;
    }

    match /handoffs/{id} {
      allow read: if isOwner() || isStaff();
      allow write: if false;
    }

    match /batches/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Saved name, document and accounts, so returning clients do not retype.
    match /clients/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['clientName', 'email', 'docType', 'docNumber', 'language', 'accounts', 'updatedAt']);
      allow delete: if false;
    }

    // Funnel analytics: one small append-only event per step.
    match /events/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'channel', 'platform', 'at', 'props'])
        && request.resource.data.name is string
        && request.resource.data.name.size() < 40;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
