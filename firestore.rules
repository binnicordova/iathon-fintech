rules_version = '2';

// Clients read their own records. Staff (Auth users with a `role` custom claim:
// admin, validator, operator, billing) read every order and invoice for the
// back-office VIEW. Only Cloud Functions write orders, quotes, invoices and
// handoffs, so the rate, fees and status can never be set from a browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && (
        (!request.auth.uid.matches('supabase:.*') && request.auth.token.get('role', '') in ['admin', 'validator', 'operator', 'billing']) ||
        (request.auth.uid.matches('supabase:.*') && get(/databases/$(database)/documents/supabaseStaff/$(request.auth.uid)).data.role in ['admin', 'validator', 'operator', 'billing'])
      );
    }

    function isOwner() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    match /config/{doc} {
      // `config/public` (pricing) and `config/rates` (market reference).
      allow read: if signedIn() && doc in ['public', 'rates'];
      allow write: if false;
    }

    match /quotes/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /orders/{id} {
      allow read: if isOwner() || isStaff();
      allow write: if false;
    }
    match /orders/{id}/events/{eventId} {
      allow read: if isStaff() || (signedIn() && get(/databases/$(database)/documents/orders/$(id)).data.uid == request.auth.uid);
      allow write: if false;
    }
    match /recipients/{uid}/accounts/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // Role grants and reference locks are server-only, including for staff clients.
    match /supabaseStaff/{id} { allow read, write: if false; }
    match /operationReferences/{id} { allow read, write: if false; }


    match /invoices/{id} {
      allow read: if isOwner() || isStaff();
      allow write: if false;
    }

    match /handoffs/{id} {
      allow read: if isOwner() || isStaff();
      allow write: if false;
    }

    match /batches/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Saved name, document and accounts, so returning clients do not retype.
    match /clients/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['clientName', 'email', 'docType', 'docNumber', 'language', 'accounts', 'updatedAt']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
